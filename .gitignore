.DS_Store

# Python bytecode cache — generated when bundled .py scripts run, not tracked state
__pycache__/
*.pyc

# Local Claude Code session config — machine-specific, never commit
/.claude/
/relay-system/

# Personal session recovery artifact — may contain pasted chat content, never commit
/snapshot.md

# Finish-line closure audit output — local, per-run parked work
/PARKED/

# Skill sync runtime log and machine-local config (absolute local paths) — not tracked state
/utils/skill-sync/skill-sync.log
/utils/skill-sync/skill-sync.conf

# Aider Studio (auto-added)
REPO_MAP.md
.aider/
.xyz/
# tick coordination event log — per-device relay/marathon runtime state, never shared
/.tick/
PROJECT/PDDA-ACTIVITY.jsonl
.pdda-gh-state.tsv

# PDDA + xyz marathon infra — local-only, drives GH-7/GH-8 planning. This repo's public face stays
# skills-only; none of this should ever reach GitHub.
/PROJECT/
/RELEASES.md
/utils/pdda/
/.pdda-mode
/.pdda-quad
.vscode/extensions.json
